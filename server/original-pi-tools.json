  {
    "name": "get_document_index",
    "description": "Read paginated YAML navigation, not the full catalog. section selects pages, tables, or both (overview).\nDefault 40 entries per section, maximum 100. pagination.pages/tables have separate filtered total,\nreturned, offset, limit, has_more and next_offset; totals are full document counts. Continue each\nsection separately with its next_offset. page_start/page_end are inclusive physical page numbers.\nquery matches all whitespace-separated terms, case-insensitively, in page headings or table IDs,\nsheet names, page headings and saved table previews. This searches navigation, not full page text;\nuse search_evidence for body text. Table preview rows appear only with include_preview=true.\nindex_path/original_path locate full files. get_source_page/get_source_table read exact original content.",
    "inputSchema": {
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "section": {
          "default": "overview",
          "enum": [
            "overview",
            "pages",
            "tables"
          ],
          "title": "Section",
          "type": "string"
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "offset": {
          "default": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 40,
          "title": "Limit",
          "type": "integer"
        },
        "page_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Start"
        },
        "page_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page End"
        },
        "include_preview": {
          "default": false,
          "title": "Include Preview",
          "type": "boolean"
        }
      },
      "required": [
        "document_id"
      ],
      "title": "get_document_indexArguments",
      "type": "object",
      "additionalProperties": false
    }
  },
