      ],
      "title": "get_source_tableArguments",
      "type": "object",
      "additionalProperties": false
    }
  },
  {
    "name": "search_evidence",
    "description": "Project-scoped FTS5 search plus configured embeddings/RRF. Filters: document_ids [], entity_id, publisher (report publisher), as_of ISO date, data_kind (structured excerpts only), document_kind. Company matches document subject associations as well as its issuer. Date/entity filters apply to both retrieval branches; unknown publication dates are excluded for as_of. Precise numeric comparisons use query_research_records or query_financial_data. Follow next_offset for more ranked evidence.",
    "inputSchema": {
      "properties": {
        "query": {
          "title": "Query",
          "type": "string"
        },
        "company": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Company"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        },
        "limit": {
          "default": 8,
          "title": "Limit",
          "type": "integer"
        },
        "filters": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filters"
        },
        "offset": {
          "default": 0,
          "title": "Offset",
          "type": "integer"
        }
      },
      "required": [
        "query"
      ],
      "title": "search_evidenceArguments",
      "type": "object",
      "additionalProperties": false
    }
  },
  {
    "name": "run_analysis",
    "description": "Run Python only in the isolated scientific container. /input/pages.json, /input/tables.json and /input/facts.json are project exports.\n/input/research_records.json contains separate, attributed research observations/forecasts/claims. Never treat estimates as disclosures.\nWrite artifacts under /output. No network, no keys, no database; missing Docker fails closed. Returns run_id.",
    "inputSchema": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "document_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Ids"
        },
        "timeout_seconds": {
          "default": 120,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "code"
      ],
      "title": "run_analysisArguments",
      "type": "object",
      "additionalProperties": false
    }
  },
  {
