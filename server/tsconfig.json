{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "./**/*.ts"
  ],
  "exclude": [
    "dist"
  ]
}
