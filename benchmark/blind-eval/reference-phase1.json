        },
        "R5": {
          "coverage": "not_tested",
          "must_mention": [],
          "scope": "表格自洽核对不是利润/CFO背离检测。"
        },
        "C": {
          "coverage": "direct",
          "must_mention": [
            "按原题交付图、CSV、Markdown及可复算代码；正文和全部仍交付版本的金额、单位、方向一致。",
            "核心源值注明文件页码、指标口径，推导列输入与公式；未实际运行的复现不声称已验证。",
            "事实、机构观点及自己的推论/假设在语言上可辨；不以引用代替因果证据。",
            "出现估值或投资判断时列关键假设、风险及适用时点/范围；不追罚原题未要求的PDF/Excel。"
          ],
          "scope": ""
        }
      },
