        },
        "R2": {
          "coverage": "direct",
          "must_mention": [
            "复算2025–2027收入/归母/EPS/增速/PE；33.82舍入33.8合理。",
            "前页27.38与p31的27.77分别定位；27.77/1.78约15.60，不编造日期或隐含精度。"
          ],
          "scope": ""
        },
        "R3": {
          "coverage": "supporting",
          "must_mention": [
            "投资逻辑和风险要有原文支持；区分披露精度允许、确切不一致、资料不足三类。"
          ],
          "scope": "研报论据和估值解释辅助考查。"
        },
        "R4": {
          "coverage": "not_tested",
