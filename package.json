{
  "name": "finance-research-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/fix_dependency.mjs",
    "prestart": "node scripts/fix_dependency.mjs --check",
    "predev": "node scripts/fix_dependency.mjs --check",
    "prebuild": "node scripts/fix_dependency.mjs --check",
    "pretypecheck": "node scripts/fix_dependency.mjs --check",
    "prebenchmark": "node scripts/fix_dependency.mjs --check",
    "deps:repair": "node scripts/fix_dependency.mjs",
    "deps:check": "node scripts/fix_dependency.mjs --check",
    "test:web:contract": "node web/tests/browser-contract.cjs",
    "test:web:live": "node web/tests/browser-live.cjs",
    "test:web:agent": "node web/tests/browser-agent-live.cjs",
    "test:web:acceptance": "node web/tests/browser-acceptance-live.cjs",
    "dev": "tsx watch server/main.ts",
    "start": "tsx server/main.ts",
    "web": "vite --config web/vite.config.ts",
    "build": "tsc -p server/tsconfig.json && vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:service": "node scripts/test_service.mjs",
    "benchmark": "tsx scripts/run_benchmark.ts",
    "release:plan": "python scripts/build_release.py --plan"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@mozilla/readability": "0.6.0",
    "express": "^5.1.0",
    "linkedom": "0.18.13",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typebox": "1.3.27",
    "zod": "^4.0.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "1.58.2",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "brace-expansion": "5.0.12"
  }
}
